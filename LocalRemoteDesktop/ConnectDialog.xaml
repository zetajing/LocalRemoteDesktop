<Window x:Class="LocalRemoteDesktop.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接远程电脑"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="OnLoaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="82"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="主机/IP" VerticalAlignment="Center" Margin="0,0,10,12"/>
        <TextBox x:Name="HostTextBox" Grid.Row="0" Grid.Column="1"
                 Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="端口" VerticalAlignment="Center" Margin="0,0,10,12"/>
        <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1"
                 Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="访问码" VerticalAlignment="Center" Margin="0,0,10,6"/>
        <PasswordBox x:Name="AccessCodeBox" Grid.Row="2" Grid.Column="1"
                     Height="28" Margin="0,0,0,6" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.Column="1"
                   Text="访问码仅用于本次连接，不会保存到最近连接。"
                   Foreground="#666" FontSize="12" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="76" Height="30" Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="连接" Width="76" Height="30"
                    IsDefault="True" Click="OnConnect"/>
        </StackPanel>
    </Grid>
</Window>
